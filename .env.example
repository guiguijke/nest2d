# =============================================================================
# NestorCut configuration example.
# Copy this file to `.env` and adjust the values for your deployment.
# All NUXT_ variables are read by the Nuxt server at startup.
# =============================================================================

# ----------------------------------------------------------------------------
# Core
# ----------------------------------------------------------------------------

# Public base URL of the deployment. Used for SEO, OAuth redirects, email links.
# In dev: http://localhost:3000
# In prod: https://app.nestorcut.com
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB connection string. The database name must be in the path because
# the workers call get_default_database().
# Local dev:    mongodb://localhost:27017/nest2d
# Docker:       mongodb://mongo:27017/nest2d
NUXT_MONGO_URI=mongodb://localhost:27017/nest2d


# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Local (email + password) authentication. Leave enabled unless you want
# Google-only auth. Set to "false" to disable.
NUXT_LOCAL_AUTH_ENABLED=true

# Google OAuth (optional). Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client, type "Web").
# Authorized redirect URI to add in the console:
#   <NUXT_PUBLIC_BASE_URL>/auth/google/callback
# The flow uses Authorization Code + PKCE (the modern, Google-recommended flow).
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Secret from the same OAuth client (Web application). Required for Web clients.
# If you configured a "Desktop"/installed app instead, leave it empty.
NUXT_GOOGLE_CLIENT_SECRET=


# ----------------------------------------------------------------------------
# Email notifications (Resend) — optional
# ----------------------------------------------------------------------------

# Resend API key. Get one at https://resend.com/api-keys
NUXT_RESEND_TOKEN=

# "From" address for outgoing emails. MUST be a domain verified in Resend,
# or use Resend's testing sender "onboarding@resend.dev".
NUXT_RESEND_FROM=onboarding@resend.dev

# ----------------------------------------------------------------------------
# Newsletter (listmonk, self-hosted) — optional
# Powers the "keep me informed" checkbox at signup. Create an API user in
# listmonk (Settings -> Users) and note the numeric id of your list.
NUXT_LISTMONK_URL=http://<IP-HOMELAB>:9000
NUXT_LISTMONK_USER=
NUXT_LISTMONK_PASSWORD=
NUXT_LISTMONK_LIST_ID=


# ----------------------------------------------------------------------------
# Payments (Stripe) — optional, configure when you wire your own Stripe account
# ----------------------------------------------------------------------------

# Stripe secret key (sk_live_... or sk_test_...).
NUXT_STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...). Find it in the Stripe dashboard
# under Developers > Webhooks > [your endpoint] > Signing secret. For local
# testing, `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints it. When empty, the webhook endpoint refuses to process events.
NUXT_STRIPE_WEBHOOK_SECRET=

# Abby API key (suk_...) — app.abby.fr > Paramètres > Intégrations. Pushes
# each Stripe collection (invoice.payment_succeeded) into the Abby income
# book (livre des recettes → URSSAF prefill). Empty = integration disabled.
NUXT_ABBY_API_KEY=


# ----------------------------------------------------------------------------
# Analytics / branding (all optional)
# ----------------------------------------------------------------------------

# Microsoft Clarity project ID. Leave empty to disable Clarity tracking.
NUXT_PUBLIC_CLARITY_ID=

# Contact/support email shown in FAQ, refund policy, terms.
NUXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Full URL of your GitHub repository (used in footer, terms, report-a-problem).
NUXT_PUBLIC_GITHUB_REPO=https://github.com/guiguijke/nestorcut

# Year shown in the footer copyright. Defaults to current year if empty.
NUXT_PUBLIC_COPYRIGHT_YEAR=

# Temporarily hide the paid-plan CTAs (Unlimited trial + Pro upgrade) until
# Strip ships to production. The cards stay visible with a "Coming soon" CTA.
# Set to false (or remove) to restore normal subscription flows.
NUXT_PUBLIC_PAID_PLANS_DISABLED=false

# Global kill-switch for the strip nesting feature (header tab, /strip pages
# and the strip API). Disabled by default while the feature is being
# reworked — set to true to re-enable it (per-user flags still apply).
NUXT_PUBLIC_STRIP_ENABLED=false

# Master switch for imperial units (inches): shows the mm/in switcher in the
# header and the standard sheet-size presets above the sheet dimensions, and
# honors users' preferredUnit. Ships dark — set to true to enable.
# NOTE: read from the container env at boot, so the value must live in THIS
# file on the server (a container recreated without it silently hides the
# switcher and the presets again).
NUXT_PUBLIC_UNIT_SWITCH_ENABLED=true

# Mode Local : le solve tourne dans le navigateur (moteur WASM, pool de
# walks par tier). Prérequis de l'import client ci-dessous.
NUXT_PUBLIC_LOCAL_COMPUTE_ENABLED=false

# J-090 — import 100 % client : à la création, un projet « 100 % privé »
# (défaut quand actif) est parsé DANS le navigateur ; le fichier n'est
# jamais uploadé (DXF/SVG ; le DWG exige le cloud). Exige LOCAL_COMPUTE.
NUXT_PUBLIC_LOCAL_IMPORT_ENABLED=false


# ----------------------------------------------------------------------------
# Geo-blocking (optional, Cloudflare-only)
# ----------------------------------------------------------------------------

# Comma-separated list of ISO country codes to block (e.g. "RU,BY").
# Only works behind Cloudflare (reads the cf-ipcountry header).
# Leave empty to disable.
NUXT_BLOCKED_COUNTRIES=


# ----------------------------------------------------------------------------
# Encryption (zero-knowledge vault, "Confidentialité+" tier)
# ----------------------------------------------------------------------------

# D-PRV-7 (2026-08-11) : la DEK de session vit en RAM process-local côté app
# et est livrée aux workers PAR JOB via ECDH éphémère — il n'y a plus aucune
# master key à configurer (les anciennes NUXT_ENCRYPTION_MASTER_KEY /
# ENCRYPTION_MASTER_KEY sont ignorées, avec un warning au boot).
# URL de l'app appelée par les workers pour la livraison de la DEK vault :
# (défaut docker-compose : http://app:3000)
NEST_APP_URL=


# ----------------------------------------------------------------------------
# Admin panel (./admin) — optional but recommended
# ----------------------------------------------------------------------------

# Destination for instant signup notifications (new-user emails sent by the
# main app) AND the periodic digest (sent by the admin panel). Leave empty to
# disable admin notifications.
NUXT_ADMIN_NOTIFY_EMAIL=

# Secret used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
NUXT_ADMIN_SESSION_SECRET=

# Base URL of the admin panel. Defaults to http://localhost:7200 in dev.
NUXT_ADMIN_BASE_URL=http://localhost:7200

# LAN-open mode: when "true", the panel requires NO login — anyone who can
# reach the port is a full admin. Intended for a trusted LAN where the port is
# NOT exposed to the Internet. Set to "false" (and create an admin via /setup)
# to require authentication again — e.g. if you ever expose the panel remotely.
NUXT_ADMIN_LAN_OPEN=true

# The admin panel connects to the SAME MongoDB. It defaults to NUXT_MONGO_URI,
# so you usually don't need to set this. Override only if the panel must reach
# a different host.
NUXT_ADMIN_MONGO_URI=
