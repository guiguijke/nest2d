-        let e2_loc = match u.partial_cmp(&0.5).unwrap() {
-            Ordering::Greater => CollisionHalf::FirstHalf,
-            Ordering::Less => CollisionHalf::SecondHalf,
-            Ordering::Equal => CollisionHalf::Halfway,
-        };
