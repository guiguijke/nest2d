-        self.contains_key(hkey)
-    }
-
-    fn insert(&mut self, hkey: HazKey, entity: HazardEntity) {
-        self.insert(hkey, entity);
-    }
-
-    fn remove_by_key(&mut self, hkey: HazKey) {
-        self.remove(hkey);
-    }
-
-    fn len(&self) -> usize {
-        self.len()
-    }
-
-    fn iter(&self) -> impl Iterator<Item = (HazKey, &HazardEntity)> {
-        self.iter()
-    }
-}
