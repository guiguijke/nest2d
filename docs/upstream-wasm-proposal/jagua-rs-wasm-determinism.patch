-        self.cde = self.container.base_cde.as_ref().clone();
-        for hazard in cde_snapshot.dynamic_hazards {
-            // re-register all dynamic hazards from the previous CDE snapshot
-            self.cde.register_hazard(hazard);
-        }
-    }
